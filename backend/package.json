{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce REST API (Express, MongoDB, MVC, JWT cookie auth)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seeder.js",
    "seed:destroy": "node src/seeder.js --destroy",
    "create:admin": "node src/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
